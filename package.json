{
  "name": "playfit-vision",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "validation:test": "vitest run src/validation",
    "validation:fixture": "node tools/validation/make-blank-video.mjs",
    "validation:report": "vite build --ssr tools/validation/report.mjs --outDir .validation-build && node .validation-build/report.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
