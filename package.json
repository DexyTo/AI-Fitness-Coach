{
  "name": "playfit-vision",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env .server-build/server/index.js --serve-client",
    "dev": "concurrently --kill-others --names api,web npm:dev:server npm:dev:client",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "db:seed:challenges": "node --env-file-if-exists=.env --import tsx server/seedChallenges.ts",
    "db:seed:challenges:built": "node --env-file-if-exists=.env .server-build/server/seedChallenges.js",
    "db:seed:demo:built": "node --env-file-if-exists=.env .server-build/server/seedDemo.js",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node --env-file-if-exists=.env .server-build/server/index.js",
    "test:server": "vitest run server",
    "test:postgres": "vitest run server/postgres.test.ts",
    "build": "npm run build:server && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "validation:test": "vitest run src/validation",
    "validation:fixture": "node tools/validation/make-blank-video.mjs",
    "validation:report": "vite build --ssr tools/validation/report.mjs --outDir .validation-build && node .validation-build/report.js",
    "db:seed:demo": "node --env-file-if-exists=.env --import tsx server/seedDemo.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@mediapipe/tasks-vision": "1.0.1",
    "better-sqlite3": "12.11.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
