{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "rootDir": "server",
    "outDir": ".server-build"
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/**/*.test.ts"]
}
