# Local API, bound to 127.0.0.1. Vite uses the same port for /api proxy.
API_PORT=3001
# Relative to the project root, independent of the shell's working directory.
DATABASE_PATH=data/playfit.sqlite

# Optional local connection to PostgreSQL. When set, SQLite is not used.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# NODE_ENV=production requires PostgreSQL, HTTPS origin and a built dist/.
# Render provides PORT and RENDER_EXTERNAL_URL automatically.
# Set PUBLIC_ORIGIN only for a custom domain or local production verification.
# PUBLIC_ORIGIN=https://playfit-vision.onrender.com
